# Rust build output
/target/

# Official Zoom SDK archives and extracted packages (licensed binaries; never commit)
/vendor/downloads/*
!/vendor/downloads/.gitkeep
/vendor/zoom-plugin-sdk/

# Packaged output
/dist/

# Secrets / local auth artifacts (tokens live in %LOCALAPPDATA%, never here)
*.dpapi
*.token
.env
.env.*
*.pem
*.pfx

# Editors / OS
.vs/
*.user
*.suo
Thumbs.db
.DS_Store

# Guest bot (tools/guest-bot)
/tools/guest-bot/node_modules/
/tools/guest-bot/guest-profiles/
/tools/guest-bot/*.png

/apps/desktop-ui/node_modules/
/apps/desktop-ui/dist/

/apps/desktop-ui/screenshots/
